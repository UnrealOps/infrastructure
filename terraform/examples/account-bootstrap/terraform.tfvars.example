aws_region = "us-west-2"

cluster_names = ["studio-dev"]

# The safest default is an IAM Identity Center permission-set role. If this is
# empty, the example trusts the permanent IAM user or role behind the credentials
# used for the apply. Always confirm trusted_principal_arns in the saved plan.
trusted_principal_arns = [
  "arn:aws:iam::123456789012:role/aws-reserved/sso.amazonaws.com/us-west-2/AWSReservedSSO_Administrators_0123456789abcdef",
]

# role_name = "StudioEKSAdministrators"
# role_path = "/unrealops/"
